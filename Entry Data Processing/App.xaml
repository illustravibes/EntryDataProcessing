<Application x:Class="Entry_Data_Processing.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Entry_Data_Processing.Shared.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrandYellow" Color="#D97706" />
            <SolidColorBrush x:Key="BrandYellowLight" Color="#FBBF24" />

            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

            <!-- Global Compact Bottom-Right Floating Toast / Alert Style -->
            <Style TargetType="{x:Type ui:Snackbar}" BasedOn="{StaticResource {x:Type ui:Snackbar}}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="MaxWidth" Value="380" />
                <Setter Property="MinHeight" Value="50" />
                <Setter Property="Margin" Value="0,0,24,24" />
                <Setter Property="Padding" Value="14,10" />
                <Style.Triggers>
                    <Trigger Property="Appearance" Value="Danger">
                        <Setter Property="Background" Value="#C42B1C" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                        <Setter Property="ContentForeground" Value="#E6FFFFFF" />
                    </Trigger>
                    <Trigger Property="Appearance" Value="Success">
                        <Setter Property="Background" Value="#0F7B0F" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                        <Setter Property="ContentForeground" Value="#E6FFFFFF" />
                    </Trigger>
                    <Trigger Property="Appearance" Value="Caution">
                        <Setter Property="Background" Value="#C25100" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                        <Setter Property="ContentForeground" Value="#E6FFFFFF" />
                    </Trigger>
                    <Trigger Property="Appearance" Value="Info">
                        <Setter Property="Background" Value="#0F6CBD" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                        <Setter Property="ContentForeground" Value="#E6FFFFFF" />
                    </Trigger>
                    <Trigger Property="Appearance" Value="Primary">
                        <Setter Property="Background" Value="#0F6CBD" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                        <Setter Property="ContentForeground" Value="#E6FFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type ui:SnackbarPresenter}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Panel.ZIndex" Value="99999" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
