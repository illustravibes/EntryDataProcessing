<Window x:Class="Entry_Data_Processing.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portal WAMB - Login"
        Width="950"
        Height="580"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown"
        SnapsToDevicePixels="True">
    <Border Margin="12" Background="White" CornerRadius="18" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="3" Opacity="0.15" Color="#000000" />
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42*" />
                <ColumnDefinition Width="58*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource OrangeBrush}" CornerRadius="15.5,0,0,15.5">
                <Grid>
                    <Grid.Resources>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#22FFFFFF" />
                        </Style>
                    </Grid.Resources>
                    <Canvas IsHitTestVisible="False" Opacity="0.55">
                        <Ellipse Width="8" Height="8" Canvas.Left="34" Canvas.Top="28" />
                        <Ellipse Width="5" Height="5" Canvas.Left="106" Canvas.Top="94" />
                        <Ellipse Width="10" Height="10" Canvas.Left="258" Canvas.Top="42" />
                        <Ellipse Width="7" Height="7" Canvas.Left="190" Canvas.Top="145" />
                        <Ellipse Width="6" Height="6" Canvas.Left="44" Canvas.Top="390" />
                        <Ellipse Width="10" Height="10" Canvas.Left="300" Canvas.Top="350" />
                        <Ellipse Width="5" Height="5" Canvas.Left="145" Canvas.Top="450" />
                    </Canvas>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="45,30,45,35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▥" Foreground="#C97848" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="Portal WAMB" Foreground="{StaticResource TextBrush}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" FontSize="15" FontWeight="Bold" Cursor="Hand" Click="CloseButton_Click" ToolTip="Tutup Aplikasi" FocusVisualStyle="{x:Null}" />
                </Grid>
                <TextBlock Grid.Row="1" Text="Silakan masuk dengan NIP Anda untuk melanjutkan" Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,7,0,36" />

                <StackPanel Grid.Row="2" Margin="0,0,0,25">
                    <TextBlock Text="NIP" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="UsernameBox" Style="{StaticResource InputTextBoxStyle}" Text="{Binding Nip, UpdateSourceTrigger=PropertyChanged}" ToolTip="Masukkan NIP Anda" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,7">
                    <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" />
                    <Grid>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBoxStyle}" PasswordChar="●" Padding="16,0,44,0" />
                        <TextBox x:Name="VisiblePasswordBox" Style="{StaticResource InputTextBoxStyle}" Visibility="Collapsed" Padding="16,0,44,0" />
                        <Button x:Name="PasswordToggleButton" Width="36" Height="36" HorizontalAlignment="Right" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="PasswordToggle_Click" ToolTip="Tampilkan password" FocusVisualStyle="{x:Null}">
                            <Grid>
                                <!-- Eye Open Icon -->
                                <Path x:Name="EyeOpenIcon"
                                      Data="M12,4.5 C7,4.5 2.73,7.61 1,12 C2.73,16.39 7,19.5 12,19.5 C17,19.5 21.27,16.39 23,12 C21.27,7.61 17,4.5 12,4.5 Z M12,17 C9.24,17 7,14.76 7,12 C7,9.24 9.24,7 12,7 C14.76,7 17,9.24 17,12 C17,14.76 14.76,17 12,17 Z M12,9 C10.34,9 9,10.34 9,12 C9,13.66 10.34,15 12,15 C13.66,15 15,13.66 15,12 C15,10.34 13.66,9 12,9 Z"
                                      Fill="{StaticResource MutedTextBrush}"
                                      Stretch="Uniform"
                                      Width="18" Height="18" />
                                <!-- Eye Slash / Closed Icon -->
                                <Path x:Name="EyeClosedIcon"
                                      Data="M12,7 C14.76,7 17,9.24 17,12 C17,12.65 16.87,13.26 16.64,13.83 L19.56,16.75 C21.07,15.49 22.26,13.86 23,12 C21.27,7.61 17,4.5 12,4.5 C10.6,4.5 9.26,4.75 8.02,5.2 L10.18,7.36 C10.74,7.13 11.35,7 12,7 Z M2,4.27 L4.28,6.55 L4.74,7.01 C3.08,8.3 1.78,10.02 1,12 C2.73,16.39 7,19.5 12,19.5 C13.55,19.5 15.03,19.2 16.38,18.66 L16.8,19.08 L19.73,22 L21,20.73 L3.27,3 L2,4.27 Z M7.53,9.8 L9.08,11.35 C9.03,11.56 9,11.78 9,12 C9,13.66 10.34,15 12,15 C12.22,15 12.44,14.97 12.65,14.92 L14.2,16.47 C13.53,16.8 12.79,17 12,17 C9.24,17 7,14.76 7,12 C7,11.21 7.2,10.47 7.53,9.8 Z M11.84,9.02 L14.99,12.17 L15.01,12.01 C15.01,10.35 13.67,9.01 12.01,9.01 L11.84,9.02 Z"
                                      Fill="{StaticResource OrangeBrush}"
                                      Stretch="Uniform"
                                      Width="18" Height="18"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>

                <Button Grid.Row="4" Content="Lupa Password?" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}" />

                <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C53030" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button x:Name="LoginButton" Content="Masuk   →" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Width="151" Click="LoginButton_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>