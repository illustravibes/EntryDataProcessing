<ui:FluentWindow x:Class="Entry_Data_Processing.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="EDP Portal Desktop" Height="720" Width="1080"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <ui:NavigationView x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed">
            <ui:NavigationView.Header>
                <ui:TitleBar x:Name="TitleBar"
                             Title="EDP Portal Desktop" />
            </ui:NavigationView.Header>
            
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="DashboardMenuItem"
                                       Content="Dashboard"
                                       Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type FrameworkElement}" />
                                       
                <ui:NavigationViewItem x:Name="ReqKodeMenuItem"
                                       Content="Request Kode Barang"
                                       Icon="{ui:SymbolIcon Box24}"
                                       TargetPageType="{x:Type FrameworkElement}" />
            </ui:NavigationView.MenuItems>
            
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="ProfileMenuItem"
                                       Content="Guest"
                                       Icon="{ui:SymbolIcon Person24}" />
                <ui:NavigationViewItem x:Name="LogoutMenuItem"
                                       Content="Logout"
                                       Icon="{ui:SymbolIcon SignOut24}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="RootSnackbar" />
                    <ContentPresenter x:Name="RootContentDialog" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
