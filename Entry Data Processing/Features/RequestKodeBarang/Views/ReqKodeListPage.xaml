<Page x:Class="Entry_Data_Processing.Features.RequestKodeBarang.Views.ReqKodeListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Approval Kode Barang"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <!-- Modern Toolbar Button -->
        <Style x:Key="ModernToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- Row Action Detail Button -->
        <Style x:Key="RowActionDetailButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row Action Approve Button -->
        <Style x:Key="RowActionApproveButton" TargetType="Button">
            <Setter Property="Background" Value="#DCFCE7" />
            <Setter Property="BorderBrush" Value="#BBF7D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BBF7D0" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row Action Reject Button -->
        <Style x:Key="RowActionRejectButton" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FECACA" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pagination Nav Button (Prev / Next) -->
        <Style x:Key="PaginationNavButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pagination Page Number Button -->
        <Style x:Key="PaginationNumberButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#0284C7" />
                    <Setter Property="BorderBrush" Value="#0284C7" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Status Tab Button Base Style -->
        <Style x:Key="StatusTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Compact DataGrid CheckBox Style (Prevents wide template clipping) -->
        <Style x:Key="DataGridCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckBorder"
                                Width="18" Height="18"
                                Background="#FFFFFF"
                                BorderBrush="#94A3B8"
                                BorderThickness="1.5"
                                CornerRadius="4">
                            <Path x:Name="CheckMark"
                                  Data="M 3.5,9 L 7.5,13 L 14.5,5"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#0284C7" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#0284C7" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#0284C7" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#0284C7" />
                                <Setter TargetName="CheckMark" Property="Data" Value="M 4,9 L 14,9" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#0284C7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#CBD5E1" />
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- FIXED VIEWPORT: Root grid with no outer scrolling -->
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: Filter Card -->
            <RowDefinition Height="Auto" /> <!-- 1: Status Tabs & Bulk Action Bar -->
            <RowDefinition Height="*" />    <!-- 2: Data Grid & Integrated Pagination Card -->
            <RowDefinition Height="Auto" /> <!-- 3: Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Modern Filter Card (Comfortable Sizing) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="14,8,14,6" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 1: Area, Toko, Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Area:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#475569" FontWeight="Medium" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}" Height="32" FontSize="12" />

                    <TextBlock Grid.Column="2" Text="Toko:" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12" Foreground="#475569" FontWeight="Medium" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding Tokos}" SelectedItem="{Binding SelectedToko}" Height="32" FontSize="12" />

                    <!-- Buttons Group -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button Content="Reset" Command="{Binding ResetFilterCommand}" Height="32" Padding="12,0" Background="#F8FAFC" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,8,0" FontSize="12" FontWeight="Medium" Cursor="Hand" />
                        <Button Content="🔍 Cari Data" Command="{Binding LoadDataCommand}" Height="32" Padding="14,0" Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0" FontSize="12" Cursor="Hand" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: Tanggal Range & Cari Input -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="135" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="135" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Tanggal:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#475569" FontWeight="Medium" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}" SelectedDateFormat="Short" Height="32" FontSize="12" />

                    <TextBlock Grid.Column="2" Text="s/d:" VerticalAlignment="Center" Margin="10,0,10,0" FontSize="12" Foreground="#64748B" />
                    <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" SelectedDateFormat="Short" Height="32" FontSize="12" />

                    <TextBlock Grid.Column="4" Text="Cari:" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12" Foreground="#475569" FontWeight="Medium" />
                    <ui:TextBox Grid.Column="5" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ketik nama barang / supplier / no request / jenis..." Height="32" FontSize="12" />
                </Grid>
            </Grid>
        </Border>

        <!-- 1. Modern Status Tabs & Bulk Action Floating Bar -->
        <Grid Grid.Row="1" Margin="14,0,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status Tabs: Semua, Pending, Approved, Rejected -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Tab: Semua -->
                <Button Command="{Binding SelectTabCommand}" CommandParameter="Semua">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StatusTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Semua">
                                    <Setter Property="Background" Value="#0284C7" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedTab}" Value="Semua" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#0369A1" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Semua" FontSize="12.5" />
                        <Border CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E2E8F0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Semua">
                                            <Setter Property="Background" Value="#0369A1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CountAll}" FontSize="11.5" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#334155" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="Semua">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Tab: Pending -->
                <Button Command="{Binding SelectTabCommand}" CommandParameter="Pending">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StatusTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Pending">
                                    <Setter Property="Background" Value="#D97706" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedTab}" Value="Pending" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#B45309" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Pending" FontSize="12.5" />
                        <Border CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEF3C7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Pending">
                                            <Setter Property="Background" Value="#B45309" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CountPending}" FontSize="11.5" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B45309" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="Pending">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Tab: Approved -->
                <Button Command="{Binding SelectTabCommand}" CommandParameter="Approved">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StatusTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Approved">
                                    <Setter Property="Background" Value="#16A34A" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedTab}" Value="Approved" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#15803D" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Approved" FontSize="12.5" />
                        <Border CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#DCFCE7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Approved">
                                            <Setter Property="Background" Value="#15803D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CountApproved}" FontSize="11.5" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#15803D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="Approved">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Tab: Rejected -->
                <Button Command="{Binding SelectTabCommand}" CommandParameter="Rejected">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StatusTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Rejected">
                                    <Setter Property="Background" Value="#DC2626" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedTab}" Value="Rejected" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#B91C1C" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Rejected" FontSize="12.5" />
                        <Border CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEE2E2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Rejected">
                                            <Setter Property="Background" Value="#B91C1C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CountRejected}" FontSize="11.5" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B91C1C" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="Rejected">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Bulk Action Floating Bar (Visible when HasSelection = True) -->
            <Border Grid.Column="1" 
                    Background="#1E293B" 
                    CornerRadius="8" 
                    Padding="14,6" 
                    VerticalAlignment="Center" 
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} item dipilih'}" 
                               Foreground="#FFFFFF" 
                               FontWeight="SemiBold" 
                               FontSize="12.5" 
                               VerticalAlignment="Center" 
                               Margin="0,0,14,0" />

                    <!-- Approve Bulk Button -->
                    <Button Command="{Binding ApproveBulkCommand}" 
                            Background="#16A34A" 
                            Foreground="#FFFFFF" 
                            FontWeight="SemiBold" 
                            BorderThickness="0" 
                            Padding="12,5" 
                            Margin="0,0,8,0" 
                            FontSize="12" 
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="14" Foreground="White" Margin="0,0,5,0" />
                            <TextBlock Text="Approve" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Reject Bulk Button -->
                    <Button Command="{Binding RejectBulkCommand}" 
                            Background="#DC2626" 
                            Foreground="#FFFFFF" 
                            FontWeight="SemiBold" 
                            BorderThickness="0" 
                            Padding="12,5" 
                            Margin="0,0,8,0" 
                            FontSize="12" 
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" Foreground="White" Margin="0,0,5,0" />
                            <TextBlock Text="Reject" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Cancel / Clear Button -->
                    <Button Command="{Binding ClearSelectionCommand}" 
                            Background="Transparent" 
                            Foreground="#94A3B8" 
                            BorderThickness="0" 
                            Padding="8,5" 
                            FontSize="12" 
                            Cursor="Hand" 
                            Content="Batal" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Modern Data Grid Card with Integrated Pagination -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="14,0,14,6" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Requests}" 
                          SelectedItem="{Binding SelectedRequest}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False" 
                          HeadersVisibility="Column" 
                          RowHeaderWidth="0" 
                          GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#F1F5F9" 
                          Background="#FFFFFF" 
                          BorderThickness="0" 
                          RowHeight="40" 
                          FontSize="12" 
                          SelectionMode="Single" 
                          SelectionUnit="FullRow" 
                          ScrollViewer.CanContentScroll="True" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto" 
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
                    </DataGrid.Resources>

                    <!-- Row Hover and Soft Selection Highlight -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!-- Cell Style without harsh blue background -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#0F172A" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <!-- Hide Row Headers to prevent left bracket artifacts -->
                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="DataGridRowHeader">
                            <Setter Property="Width" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MaxWidth" Value="0" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </DataGrid.RowHeaderStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="Foreground" Value="#475569" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="6,8" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- Checkbox Select Column (Width 38) - Always Visible, Disabled when Not Pending -->
                        <DataGridTemplateColumn Width="38" CanUserResize="False">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,8" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.Header>
                                <CheckBox Style="{StaticResource DataGridCheckBoxStyle}"
                                          IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=Page}}" 
                                          IsEnabled="{Binding DataContext.IsBulkActionAvailable, RelativeSource={RelativeSource AncestorType=Page}}"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Margin="0" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource DataGridCheckBoxStyle}"
                                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                              IsEnabled="{Binding CanApproveOrReject}"
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- No (Width 36) -->
                        <DataGridTextColumn Header="NO" Binding="{Binding RowNumber}" IsReadOnly="True" Width="36">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,8" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#64748B" />
                                    <Setter Property="FontSize" Value="11.5" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- TANGGAL REQUEST (Width 125) -->
                        <DataGridTextColumn Header="TANGGAL REQUEST" Binding="{Binding FormattedTglRequest}" IsReadOnly="True" Width="125">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,8" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#334155" />
                                    <Setter Property="FontSize" Value="11.5" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- TOKO (Width 170) -->
                        <DataGridTemplateColumn Header="TOKO" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding TokoKodeAndName}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12" 
                                                   Foreground="#0F172A" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   MaxWidth="125" 
                                                   VerticalAlignment="Center" />
                                        <!-- Area Badge (JGJ) -->
                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="4,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AreaBadge}" FontSize="9" FontWeight="Bold" Foreground="#475569" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- NAMA BARANG + Badge (Width Flex *) -->
                        <DataGridTemplateColumn Header="NAMA BARANG" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding NmBrg}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12" 
                                                   Foreground="#0F172A" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   MaxWidth="180"
                                                   VerticalAlignment="Center" />
                                        <!-- R/M Inline Badge -->
                                        <Border CornerRadius="6" Padding="5,1.5" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E0F2FE" />
                                                    <Setter Property="BorderBrush" Value="#BAE6FD" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMix}" Value="True">
                                                            <Setter Property="Background" Value="#FCE7F3" />
                                                            <Setter Property="BorderBrush" Value="#FBCFE8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RmBadgeText}" FontSize="9" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#0284C7" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMix}" Value="True">
                                                                <Setter Property="Foreground" Value="#DB2777" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- JENIS (Width 95) -->
                        <DataGridTextColumn Header="JENIS" Binding="{Binding JenisDisplay}" IsReadOnly="True" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="4,0" />
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Setter Property="FontSize" Value="11.5" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- SUPPLIER (Width 110) -->
                        <DataGridTemplateColumn Header="SUPPLIER" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding SupplierDisplay}" VerticalAlignment="Center" Foreground="#334155" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="82" />
                                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="3" Padding="3,0" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsNewSupplier, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="BARU" FontSize="8" FontWeight="Bold" Foreground="#B45309" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- PRICELIST (Width 85) -->
                        <DataGridTextColumn Header="PRICELIST" Binding="{Binding FormattedPricelist}" IsReadOnly="True" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,0,6,0" />
                                    <Setter Property="Foreground" Value="#334155" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- DISKON (Badge, Width 60) -->
                        <DataGridTemplateColumn Header="DISKON" Width="60">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,8" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            CornerRadius="4" 
                                            Padding="5,2" 
                                            Background="{Binding DiscBadgeBackground}" 
                                            BorderBrush="{Binding DiscBadgeBorder}" 
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding DiscBadgeText}" 
                                                   FontSize="10.5" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{Binding DiscBadgeForeground}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- HARGA BELI (Width 95) -->
                        <DataGridTextColumn Header="HARGA BELI" Binding="{Binding FormattedHrgBeli}" IsReadOnly="True" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,0,6,0" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#0F172A" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- STATUS (Width 85) -->
                        <DataGridTemplateColumn Header="STATUS" Width="85">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,8" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="7,2.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF3C7" />
                                                <Setter Property="BorderBrush" Value="#FDE68A" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AccTidak}" Value="1">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                        <Setter Property="BorderBrush" Value="#BBF7D0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccTidak}" Value="2">
                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                        <Setter Property="BorderBrush" Value="#FECACA" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccTidak}" Value="3">
                                                        <Setter Property="Background" Value="#EEF2FF" />
                                                        <Setter Property="BorderBrush" Value="#E0E7FF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="10.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#B45309" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccTidak}" Value="1">
                                                            <Setter Property="Foreground" Value="#15803D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccTidak}" Value="2">
                                                            <Setter Property="Foreground" Value="#B91C1C" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccTidak}" Value="3">
                                                            <Setter Property="Foreground" Value="#4338CA" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- AKSI (Width 108) -->
                        <DataGridTemplateColumn Header="AKSI" Width="108">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,8" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Detail (Always visible) -->
                                        <Button Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource RowActionDetailButton}" 
                                                ToolTip="Lihat Detail">
                                            <ui:SymbolIcon Symbol="Eye20" FontSize="13" Foreground="#475569" />
                                        </Button>
                                        <!-- Approve (Only when Pending) -->
                                        <Button Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource RowActionApproveButton}" 
                                                Visibility="{Binding CanApproveOrReject, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                                ToolTip="Setujui Request">
                                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="13" Foreground="#16A34A" />
                                        </Button>
                                        <!-- Reject (Only when Pending) -->
                                        <Button Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource RowActionRejectButton}" 
                                                Visibility="{Binding CanApproveOrReject, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                                ToolTip="Tolak Request">
                                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="13" Foreground="#DC2626" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading Overlay -->
                <ui:ProgressRing Grid.Row="0"
                                  IsIndeterminate="True" 
                                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" />

                <!-- 3. Dynamic Modern Pagination Footer (Integrated inside Card) -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <!-- Summary Text -->
                        <TextBlock Text="{Binding PaginationSummary}" 
                                   VerticalAlignment="Center" 
                                   Foreground="#64748B" 
                                   FontSize="12" 
                                   FontWeight="Medium" />

                        <!-- Dynamic Pagination Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding PrevPageCommand}" Style="{StaticResource PaginationNavButton}" ToolTip="Halaman Sebelumnya">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ChevronLeft20" FontSize="12" Margin="0,0,3,0" />
                                    <TextBlock Text="Prev" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <ItemsControl ItemsSource="{Binding PageNumbers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding PageNumber}" 
                                                Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                CommandParameter="{Binding PageNumber}" 
                                                Style="{StaticResource PaginationNumberButton}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Command="{Binding NextPageCommand}" Style="{StaticResource PaginationNavButton}" ToolTip="Halaman Berikutnya">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Next" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                    <ui:SymbolIcon Symbol="ChevronRight20" FontSize="12" Margin="3,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 4. Modern Bottom Status Bar -->
        <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Green Connection Indicator -->
                    <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ServerInfo}" FontSize="11.5" Foreground="#475569" FontWeight="Medium" Margin="0,0,18,0" />

                    <!-- User Info & Pending Count -->
                    <TextBlock Text="{Binding UserInfo}" FontSize="11.5" Foreground="#475569" Margin="0,0,18,0" />
                    <TextBlock Text="Total pending: " FontSize="11.5" Foreground="#475569" />
                    <Border Background="#FEF3C7" CornerRadius="4" Padding="6,1.5" Margin="4,0,0,0">
                        <TextBlock Text="{Binding TotalPendingCount}" FontSize="11.5" FontWeight="Bold" Foreground="#B45309" />
                    </Border>
                </StackPanel>

                <!-- Current Date Time -->
                <TextBlock Text="{Binding CurrentDateTime}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="#94A3B8" />
            </Grid>
        </Border>
    </Grid>
</Page>
