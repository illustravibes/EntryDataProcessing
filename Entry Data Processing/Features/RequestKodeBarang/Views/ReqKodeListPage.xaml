<Page x:Class="Entry_Data_Processing.Features.RequestKodeBarang.Views.ReqKodeListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Approval Kode Barang"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>

        <Style x:Key="PrimaryFilterButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0369A1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#075985" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="SyncFilterButton" TargetType="Button">
            <Setter Property="Background" Value="#F0FDF4" />
            <Setter Property="Foreground" Value="#166534" />
            <Setter Property="BorderBrush" Value="#BBF7D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DCFCE7" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#86EFAC" />
                                <Setter Property="Foreground" Value="#15803D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#BBF7D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="SecondaryFilterButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ModernToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>


        <Style x:Key="RowActionDetailButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="RowActionApproveButton" TargetType="Button">
            <Setter Property="Background" Value="#DCFCE7" />
            <Setter Property="BorderBrush" Value="#BBF7D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BBF7D0" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="RowActionRejectButton" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FECACA" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="PaginationNavButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="PaginationNumberButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#0284C7" />
                    <Setter Property="BorderBrush" Value="#0284C7" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="StatusTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="DataGridCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="RootGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="CheckBorder"
                                    Width="18" Height="18"
                                    Background="#FFFFFF"
                                    BorderBrush="#94A3B8"
                                    BorderThickness="1.5"
                                    CornerRadius="5">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <Path x:Name="CheckMark"
                                          Data="M 3.8,9.2 L 7.4,12.8 L 14.2,5.2"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="1.85"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />


                                    <Rectangle x:Name="IndeterminateMark"
                                               Width="9" Height="2.5"
                                               RadiusX="1.25" RadiusY="1.25"
                                               Fill="#FFFFFF"
                                               Visibility="Collapsed"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#0284C7" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#0369A1" />
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#0284C7" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#0284C7" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#0369A1" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#0369A1" />
                            </MultiTrigger>

                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#0284C7" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#0284C7" />
                                <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ModernColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />


                                <Rectangle Width="1"
                                           Fill="#CBD5E1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Stretch"
                                           Margin="0,9,0,9"
                                           SnapsToDevicePixels="True"
                                           IsHitTestVisible="False" />


                                <Thumb x:Name="PART_RightHeaderGripper"
                                       HorizontalAlignment="Right"
                                       Width="6"
                                       Cursor="SizeWE">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                             <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ModernCenterColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,0" />
        </Style>


        <Style x:Key="ModernFirstColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0,0,0" />
        </Style>


        <Style x:Key="ModernRightColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,12,0" />
        </Style>


        <Style x:Key="ModernLastColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0,0,14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>


    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="14,8,14,6" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0" Text="Area:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#475569" FontWeight="Medium" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}" Height="32" FontSize="12" />


                    <TextBlock Grid.Column="2" Text="Toko:" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12" Foreground="#475569" FontWeight="Medium" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding Tokos}" SelectedItem="{Binding SelectedToko}" Height="32" FontSize="12" />


                    <TextBlock Grid.Column="4" Text="Periode:" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12" Foreground="#475569" FontWeight="Medium" />
                    <ComboBox Grid.Column="5" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" Height="32" FontSize="12" />


                    <DatePicker Grid.Column="6"
                                SelectedDate="{Binding SelectedSingleDate}"
                                SelectedDateFormat="Short"
                                Height="32"
                                FontSize="12"
                                Width="130"
                                Margin="8,0,0,0"
                                Visibility="{Binding IsSingleDateVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>


                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Cari:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#475569" FontWeight="Medium" />
                    <ui:TextBox Grid.Column="1"
                                Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Ketik nama barang / supplier / no request / jenis (otomatis filter saat mengetik)..."
                                Height="32"
                                FontSize="12"
                                Margin="0,0,12,0" />


                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                        <ui:Button Command="{Binding ResetFilterCommand}"
                                Style="{StaticResource SecondaryFilterButton}"
                                Margin="0,0,8,0"
                                ToolTip="Reset Semua Filter ke Default">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowReset20" FontSize="13" Foreground="#64748B" Margin="0,0,5,0" />
                                <TextBlock Text="Reset" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>


                        <ui:Button Command="{Binding SyncDataCommand}"
                                   Style="{StaticResource SyncFilterButton}"
                                   Margin="0,0,8,0"
                                   ToolTip="Sinkronisasi &amp; Refresh Data Terbaru dari Server">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSync20" FontSize="13" Foreground="#16A34A" Margin="0,0,5,0" />
                                <TextBlock Text="Sync Data" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>


                        <ui:Button Command="{Binding LoadDataCommand}"
                                   Style="{StaticResource PrimaryFilterButton}"
                                   ToolTip="Terapkan Filter / Cari Manual">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Search20" FontSize="13" Foreground="White" Margin="0,0,5,0" />
                                <TextBlock Text="Cari Data" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>


        <Grid Grid.Row="1" Margin="14,0,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                <ui:Button Command="{Binding SelectTabCommand}" CommandParameter="Pending">
                    <ui:Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StatusTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Pending">
                                    <Setter Property="Background" Value="#EAB308" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedTab}" Value="Pending" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#CA8A04" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Pending" FontSize="12.5" />
                        <Border CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEF9C3" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Pending">
                                            <Setter Property="Background" Value="#CA8A04" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CountPending}" FontSize="11.5" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A16207" />
