                                <DataTrigger Binding="{Binding SelectedTab}" Value="Approved">
                                    <Setter Property="Background" Value="#16A34A" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedTab}" Value="Approved" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#15803D" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Approved" FontSize="12.5" />
                        <Border CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#DCFCE7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Approved">
                                            <Setter Property="Background" Value="#15803D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CountApproved}" FontSize="11.5" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#15803D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="Approved">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ui:Button>


                <ui:Button Command="{Binding SelectTabCommand}" CommandParameter="Rejected">
                    <ui:Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StatusTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Rejected">
                                    <Setter Property="Background" Value="#DC2626" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedTab}" Value="Rejected" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#B91C1C" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Rejected" FontSize="12.5" />
                        <Border CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEE2E2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Rejected">
                                            <Setter Property="Background" Value="#B91C1C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CountRejected}" FontSize="11.5" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B91C1C" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="Rejected">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ui:Button>


                <ui:Button Command="{Binding SelectTabCommand}" CommandParameter="Semua">
                    <ui:Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StatusTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Semua">
                                    <Setter Property="Background" Value="#0284C7" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedTab}" Value="Semua" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#0369A1" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Semua" FontSize="12.5" />
                        <Border CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E2E8F0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Semua">
                                            <Setter Property="Background" Value="#0369A1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CountAll}" FontSize="11.5" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#334155" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="Semua">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ui:Button>
            </StackPanel>


            <Border Grid.Column="1"
                    Background="#1E293B"
                    CornerRadius="8"
                    Padding="14,6"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} item dipilih'}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />


                    <ui:Button Command="{Binding ApproveBulkCommand}"
                            Background="#16A34A"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Padding="12,5"
                            Margin="0,0,8,0"
                            FontSize="12"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="14" Foreground="White" Margin="0,0,5,0" />
                            <TextBlock Text="Approve" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>


                    <ui:Button Command="{Binding RejectBulkCommand}"
                            Background="#DC2626"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Padding="12,5"
                            Margin="0,0,8,0"
                            FontSize="12"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" Foreground="White" Margin="0,0,5,0" />
                            <TextBlock Text="Reject" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>


                    <ui:Button Command="{Binding ClearSelectionCommand}"
                            Background="Transparent"
                            Foreground="#94A3B8"
                            BorderThickness="0"
                            Padding="8,5"
                            FontSize="12"
                            Cursor="Hand"
                            Content="Batal" />
                </StackPanel>
            </Border>
        </Grid>


        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="14,0,14,14" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Requests}"
                          SelectedItem="{Binding SelectedRequest}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          Background="#FFFFFF"
                          BorderThickness="0"
                          RowHeight="44"
                          FontSize="12"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">


                    <DataGrid.Template>
                        <ControlTemplate TargetType="{x:Type DataGrid}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="DG_ScrollViewer" Focusable="false">
                                    <ScrollViewer.Template>
                                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>


                                                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                        Background="#F8FAFC"
                                                        BorderBrush="#E2E8F0"
                                                        BorderThickness="0,0,0,1"
                                                        Height="42" />


                                                <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                                                Grid.Row="0"
                                                                                Grid.Column="1"
                                                                                Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />


                                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                        Grid.Row="1"
                                                                        Grid.Column="0"
                                                                        Grid.ColumnSpan="2"
                                                                        CanContentScroll="{TemplateBinding CanContentScroll}" />


                                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                                           Grid.Row="1"
                                                           Grid.Column="2"
                                                           Maximum="{TemplateBinding ScrollableHeight}"
                                                           Orientation="Vertical"
                                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                           ViewportSize="{TemplateBinding ViewportHeight}" />


                                                <Grid Grid.Row="2" Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding NonFrozenColumnsViewportHorizontalOffset, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ScrollBar x:Name="PART_HorizontalScrollBar"
                                                               Grid.Column="1"
                                                               Maximum="{TemplateBinding ScrollableWidth}"
                                                               Orientation="Horizontal"
                                                               Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                               Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                               ViewportSize="{TemplateBinding ViewportWidth}" />
                                                </Grid>
                                            </Grid>
                                        </ControlTemplate>
                                    </ScrollViewer.Template>
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </DataGrid.Template>

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
                    </DataGrid.Resources>


                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>


                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#0F172A" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>


                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="DataGridRowHeader">
                            <Setter Property="Width" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MaxWidth" Value="0" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </DataGrid.RowHeaderStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernColumnHeaderStyle}" />
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="52" CanUserResize="False" HeaderStyle="{StaticResource ModernCenterColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.Header>
                                <CheckBox Style="{StaticResource DataGridCheckBoxStyle}"
                                          IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=Page}}"
                                          IsEnabled="{Binding DataContext.IsBulkActionAvailable, RelativeSource={RelativeSource AncestorType=Page}}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="0" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource DataGridCheckBoxStyle}"
                                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanApproveOrReject}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn Header="NO" Binding="{Binding RowNumber}" IsReadOnly="True" Width="46" HeaderStyle="{StaticResource ModernCenterColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#64748B" />
                                    <Setter Property="FontSize" Value="11.5" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>


                        <DataGridTemplateColumn Header="AKSI" Width="108" HeaderStyle="{StaticResource ModernCenterColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                                        <ui:Button Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource RowActionDetailButton}"
                                                ToolTip="Lihat Detail">
                                            <ui:SymbolIcon Symbol="Eye20" FontSize="13" Foreground="#475569" />
                                        </ui:Button>

                                        <ui:Button Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource RowActionApproveButton}"
                                                Visibility="{Binding CanApproveOrReject, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="Setujui Request">
                                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="13" Foreground="#16A34A" />
                                        </ui:Button>

                                        <ui:Button Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource RowActionRejectButton}"
                                                Visibility="{Binding CanApproveOrReject, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="Tolak Request">
                                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="13" Foreground="#DC2626" />
                                        </ui:Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn Header="STATUS" Width="100" HeaderStyle="{StaticResource ModernCenterColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                             <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF3C7" />
                                                <Setter Property="BorderBrush" Value="#FDE68A" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NormalizedStatus}" Value="Disetujui">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                        <Setter Property="BorderBrush" Value="#BBF7D0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NormalizedStatus}" Value="Ditolak">
                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                        <Setter Property="BorderBrush" Value="#FECACA" />
                                                        <Setter Property="ToolTip" Value="{Binding KeteranganTolak}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NormalizedStatus}" Value="Draft">
                                                        <Setter Property="Background" Value="#EEF2FF" />
                                                        <Setter Property="BorderBrush" Value="#E0E7FF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                             </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="10.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#B45309" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NormalizedStatus}" Value="Disetujui">
                                                            <Setter Property="Foreground" Value="#15803D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NormalizedStatus}" Value="Ditolak">
                                                            <Setter Property="Foreground" Value="#B91C1C" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NormalizedStatus}" Value="Draft">
                                                            <Setter Property="Foreground" Value="#4338CA" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn Header="TANGGAL REQUEST" Binding="{Binding FormattedTglRequest}" IsReadOnly="True" Width="130" HeaderStyle="{StaticResource ModernCenterColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#334155" />
                                    <Setter Property="FontSize" Value="11.5" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>


                        <DataGridTextColumn Header="TGL APPROVE" Binding="{Binding FormattedTglAcc}" IsReadOnly="True" Width="130" HeaderStyle="{StaticResource ModernCenterColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#334155" />
                                    <Setter Property="FontSize" Value="11.5" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>


                        <DataGridTemplateColumn Header="TOKO" Width="175" HeaderStyle="{StaticResource ModernColumnHeaderStyle}">
