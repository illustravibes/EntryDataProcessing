<Page x:Class="Entry_Data_Processing.Features.RequestKodeBarang.Views.ReqKodeListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Approval Kode Barang">

    <Page.Resources>
        <!-- Modern Soft Action Button -->
        <Style x:Key="ModernToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- Mini Row Action Button -->
        <Style x:Key="RowActionButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Modern Status Tab Button Style -->
        <Style x:Key="StatusTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Action Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Filter Card -->
            <RowDefinition Height="Auto" /> <!-- Status Tabs Bar -->
            <RowDefinition Height="*" />    <!-- Data Grid -->
            <RowDefinition Height="Auto" /> <!-- Pagination Footer -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Modern Action Toolbar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding LoadDataCommand}" Style="{StaticResource ModernToolbarButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↻" FontWeight="Bold" Margin="0,0,6,0" Foreground="#0284C7" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ApproveCommand}" CommandParameter="{Binding SelectedRequest}" Style="{StaticResource ModernToolbarButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontWeight="Bold" Margin="0,0,6,0" Foreground="#16A34A" />
                        <TextBlock Text="Approve" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding RejectCommand}" CommandParameter="{Binding SelectedRequest}" Style="{StaticResource ModernToolbarButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕" FontWeight="Bold" Margin="0,0,6,0" Foreground="#DC2626" />
                        <TextBlock Text="Reject" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ViewDetailCommand}" CommandParameter="{Binding SelectedRequest}" Style="{StaticResource ModernToolbarButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👁" Margin="0,0,6,0" Foreground="#64748B" />
                        <TextBlock Text="Detail" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#E2E8F0" Margin="6,0,12,0" VerticalAlignment="Center" />

                <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource ModernToolbarButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Margin="0,0,6,0" />
                        <TextBlock Text="Export Excel" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding PrintCommand}" Style="{StaticResource ModernToolbarButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖨" Margin="0,0,6,0" />
                        <TextBlock Text="Print" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. Clean & Tidy Filter Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="16,10,16,8" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header Title -->
                <TextBlock Grid.Row="0" Text="FILTER DATA" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,10" />

                <!-- Row 1: Area, Toko, Buttons -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Area:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#475569" FontWeight="Medium" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}" Height="32" FontSize="12" />

                    <TextBlock Grid.Column="2" Text="Toko:" VerticalAlignment="Center" Margin="18,0,8,0" FontSize="12" Foreground="#475569" FontWeight="Medium" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding Tokos}" SelectedItem="{Binding SelectedToko}" Height="32" FontSize="12" />

                    <!-- Buttons Group -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button Content="Reset" Command="{Binding ResetFilterCommand}" Height="32" Padding="14,0" Background="#F8FAFC" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,8,0" FontSize="12" FontWeight="Medium" Cursor="Hand" />
                        <Button Content="🔍 Cari Data" Command="{Binding LoadDataCommand}" Height="32" Padding="16,0" Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0" FontSize="12" Cursor="Hand" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: Tanggal Range & Cari Input -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Tanggal:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#475569" FontWeight="Medium" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}" SelectedDateFormat="Short" Height="32" FontSize="12" />

                    <TextBlock Grid.Column="2" Text="s/d:" VerticalAlignment="Center" Margin="12,0,12,0" FontSize="12" Foreground="#64748B" />
                    <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" SelectedDateFormat="Short" Height="32" FontSize="12" />

                    <TextBlock Grid.Column="4" Text="Cari:" VerticalAlignment="Center" Margin="20,0,8,0" FontSize="12" Foreground="#475569" FontWeight="Medium" />
                    <ui:TextBox Grid.Column="5" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ketik nama barang / supplier / no request..." Height="32" FontSize="12" />
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Modern Status Tabs (Semua, Draft, Pending, Approved, Rejected) -->
        <Border Grid.Row="2" Margin="16,0,16,6">
            <StackPanel Orientation="Horizontal">
                <!-- Tab: Semua -->
                <Button Command="{Binding SelectTabCommand}" CommandParameter="Semua" Style="{StaticResource StatusTabButtonStyle}">
                    <Button.Triggers>
                    </Button.Triggers>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Semua" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Semua">
                                            <Setter Property="Foreground" Value="#0284C7" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Background="#E2E8F0" CornerRadius="10" Padding="7,1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding CountAll}" FontSize="11" FontWeight="Bold" Foreground="#334155" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Tab: Draft -->
                <Button Command="{Binding SelectTabCommand}" CommandParameter="Draft" Style="{StaticResource StatusTabButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Draft" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Draft">
                                            <Setter Property="Foreground" Value="#4338CA" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Background="#E0E7FF" CornerRadius="10" Padding="7,1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding CountDraft}" FontSize="11" FontWeight="Bold" Foreground="#4338CA" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Tab: Pending -->
                <Button Command="{Binding SelectTabCommand}" CommandParameter="Pending" Style="{StaticResource StatusTabButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Pending" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Pending">
                                            <Setter Property="Foreground" Value="#B45309" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Background="#FEF3C7" CornerRadius="10" Padding="7,1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding CountPending}" FontSize="11" FontWeight="Bold" Foreground="#B45309" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Tab: Approved -->
                <Button Command="{Binding SelectTabCommand}" CommandParameter="Approved" Style="{StaticResource StatusTabButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Approved" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Approved">
                                            <Setter Property="Foreground" Value="#15803D" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Background="#DCFCE7" CornerRadius="10" Padding="7,1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding CountApproved}" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Tab: Rejected -->
                <Button Command="{Binding SelectTabCommand}" CommandParameter="Rejected" Style="{StaticResource StatusTabButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Rejected" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="Rejected">
                                            <Setter Property="Foreground" Value="#B91C1C" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Background="#FEE2E2" CornerRadius="10" Padding="7,1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding CountRejected}" FontSize="11" FontWeight="Bold" Foreground="#B91C1C" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 4. Modern Data Grid Card -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="16,0,16,0" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Requests}" 
                          SelectedItem="{Binding SelectedRequest}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          Background="#FFFFFF"
                          BorderThickness="0"
                          RowHeight="42"
                          FontSize="12"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="Foreground" Value="#475569" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,10" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- No -->
                        <DataGridTextColumn Header="No" Binding="{Binding RowNumber}" Width="45">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#64748B" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tgl Request -->
                        <DataGridTextColumn Header="Tgl Request" Binding="{Binding FormattedTglRequest}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#334155" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Toko / Area (2 baris) -->
                        <DataGridTemplateColumn Header="Toko / Area" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="{Binding TokoDisplay}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AreaDisplay}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Nama Barang -->
                        <DataGridTextColumn Header="Nama Barang" Binding="{Binding NmBrg}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="6,0" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#0F172A" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Jenis -->
                        <DataGridTextColumn Header="Jenis" Binding="{Binding JnsBrg}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="6,0" />
                                    <Setter Property="Foreground" Value="#475569" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- R/M Badge -->
                        <DataGridTemplateColumn Header="R/M" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E0F2FE" />
                                                <Setter Property="BorderBrush" Value="#BAE6FD" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMix}" Value="True">
                                                        <Setter Property="Background" Value="#FCE7F3" />
                                                        <Setter Property="BorderBrush" Value="#FBCFE8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RmBadgeText}" FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#0284C7" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMix}" Value="True">
                                                            <Setter Property="Foreground" Value="#DB2777" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Supplier + Badge BARU -->
                        <DataGridTemplateColumn Header="Supplier" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="{Binding Supplier}" VerticalAlignment="Center" Foreground="#334155" />
                                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsNewSupplier, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="BARU" FontSize="8" FontWeight="Bold" Foreground="#B45309" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Pricelist -->
                        <DataGridTextColumn Header="Pricelist" Binding="{Binding FormattedPricelist}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                    <Setter Property="Foreground" Value="#334155" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Hrg Beli -->
                        <DataGridTextColumn Header="Hrg Beli" Binding="{Binding FormattedHrgBeli}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#0F172A" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status -->
                        <DataGridTemplateColumn Header="Status" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Default: Pending / Draft -->
                                                <Setter Property="Background" Value="#FEF3C7" />
                                                <Setter Property="BorderBrush" Value="#FDE68A" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <!-- Approved (1) -->
                                                    <DataTrigger Binding="{Binding AccTidak}" Value="1">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                        <Setter Property="BorderBrush" Value="#BBF7D0" />
                                                    </DataTrigger>
                                                    <!-- Rejected (2) -->
                                                    <DataTrigger Binding="{Binding AccTidak}" Value="2">
                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                        <Setter Property="BorderBrush" Value="#FECACA" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#B45309" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccTidak}" Value="1">
                                                            <Setter Property="Foreground" Value="#15803D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccTidak}" Value="2">
                                                            <Setter Property="Foreground" Value="#B91C1C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Aksi (3 mini buttons) -->
                        <DataGridTemplateColumn Header="Aksi" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Detail -->
                                        <Button Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource RowActionButton}" 
                                                ToolTip="Lihat Detail">
                                            <TextBlock Text="👁" FontSize="11" Foreground="#475569" />
                                        </Button>
                                        <!-- Approve -->
                                        <Button Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource RowActionButton}" 
                                                ToolTip="Approve">
                                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#16A34A" />
                                        </Button>
                                        <!-- Reject -->
                                        <Button Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource RowActionButton}" 
                                                ToolTip="Reject">
                                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#DC2626" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading Overlay -->
                <ui:ProgressRing IsIndeterminate="True" 
                                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 5. Modern Pagination Footer -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10" Margin="0,10,0,0">
            <Grid>
                <!-- Summary Text -->
                <TextBlock Text="{Binding PaginationSummary}" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" />

                <!-- Pagination Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="« Prev" Command="{Binding PrevPageCommand}" Style="{StaticResource ModernToolbarButton}" Padding="10,4" FontSize="11" />
                    <Button Content="1" Command="{Binding GoToPageCommand}" CommandParameter="1" Style="{StaticResource ModernToolbarButton}" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="10,4" FontSize="11" />
                    <Button Content="2" Command="{Binding GoToPageCommand}" CommandParameter="2" Style="{StaticResource ModernToolbarButton}" Padding="10,4" FontSize="11" />
                    <Button Content="Next »" Command="{Binding NextPageCommand}" Style="{StaticResource ModernToolbarButton}" Padding="10,4" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 6. Modern Bottom Status Bar -->
        <Border Grid.Row="5" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Green Connection Indicator -->
                    <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ServerInfo}" FontSize="11" Foreground="#475569" FontWeight="Medium" Margin="0,0,20,0" />

                    <!-- User Info & Pending Count -->
                    <TextBlock Text="{Binding UserInfo}" FontSize="11" Foreground="#475569" Margin="0,0,20,0" />
                    <TextBlock Text="Total pending: " FontSize="11" Foreground="#475569" />
                    <Border Background="#FEF3C7" CornerRadius="4" Padding="6,1" Margin="4,0,0,0">
                        <TextBlock Text="{Binding TotalPendingCount}" FontSize="11" FontWeight="Bold" Foreground="#B45309" />
                    </Border>
                </StackPanel>

                <!-- Current Date Time -->
                <TextBlock Text="{Binding CurrentDateTime}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8" />
            </Grid>
        </Border>
    </Grid>
</Page>
