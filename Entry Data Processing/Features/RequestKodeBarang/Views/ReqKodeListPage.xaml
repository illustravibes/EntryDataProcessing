                                            <TextBlock Text="{Binding AreaBadge}" FontSize="9" FontWeight="Bold" Foreground="#475569" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn Header="NAMA BARANG" Width="*" MinWidth="150" HeaderStyle="{StaticResource ModernColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding NmBrg}"
                                                    FontWeight="SemiBold"
                                                    FontSize="12"
                                                    Foreground="#0F172A"
                                                    TextTrimming="CharacterEllipsis"
                                                    MaxWidth="250"
                                                    VerticalAlignment="Center" />

                                        <Border CornerRadius="6" Padding="5,1.5" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E0F2FE" />
                                                    <Setter Property="BorderBrush" Value="#BAE6FD" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMix}" Value="True">
                                                            <Setter Property="Background" Value="#FCE7F3" />
                                                            <Setter Property="BorderBrush" Value="#FBCFE8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RmBadgeText}" FontSize="9" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#0284C7" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMix}" Value="True">
                                                                <Setter Property="Foreground" Value="#DB2777" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn Header="JENIS" Binding="{Binding JenisDisplay}" IsReadOnly="True" Width="105" HeaderStyle="{StaticResource ModernColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Setter Property="FontSize" Value="11.5" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>


                        <DataGridTemplateColumn Header="SUPPLIER" Width="130" HeaderStyle="{StaticResource ModernColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding SupplierDisplay}" VerticalAlignment="Center" Foreground="#334155" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="95" />
                                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="3" Padding="3,0" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsNewSupplier, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="BARU" FontSize="8" FontWeight="Bold" Foreground="#B45309" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn Header="PRICELIST" Binding="{Binding FormattedPricelist}" IsReadOnly="True" Width="100" HeaderStyle="{StaticResource ModernRightColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,0,10,0" />
                                    <Setter Property="Foreground" Value="#334155" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>


                        <DataGridTemplateColumn Header="DISKON" Width="70" HeaderStyle="{StaticResource ModernCenterColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="4"
                                            Padding="5,2"
                                            Background="{Binding DiscBadgeBackground}"
                                            BorderBrush="{Binding DiscBadgeBorder}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding DiscBadgeText}"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding DiscBadgeForeground}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn Header="HARGA BELI" Binding="{Binding FormattedHrgBeli}" IsReadOnly="True" Width="110" HeaderStyle="{StaticResource ModernLastColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,0,12,0" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#0F172A" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>


                <Border Grid.Row="0"
                        Margin="0,42,0,0"
                        Background="#FFFFFF"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40">

                        <Border Width="64" Height="64" CornerRadius="32" Background="#FEF9C3" BorderBrush="#FEF08A" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="ClipboardCheckmark24" FontSize="30" Foreground="#CA8A04" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>


                        <TextBlock Text="{Binding EmptyStateTitle}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />


                        <TextBlock Text="{Binding EmptyStateDescription}"
                                   FontSize="12.5"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="480"
                                   TextWrapping="Wrap" />


                        <ui:Button Command="{Binding LoadDataCommand}"
                                   Margin="0,18,0,0"
                                   Padding="16,6"
                                   Appearance="Secondary"
                                   CornerRadius="6"
                                   HorizontalAlignment="Center"
                                   Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="#475569" Margin="0,0,6,0" />
                                <TextBlock Text="Segarkan Data" FontSize="12" FontWeight="Medium" Foreground="#334155" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Border>


                <Border Grid.Row="0"
                        Margin="0,42,0,0"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Panel.ZIndex="10">
                    <Border.Background>
                        <SolidColorBrush Color="#FFFFFF" Opacity="0.92"/>
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="48" Height="48"
                                         HorizontalAlignment="Center" />
                        <TextBlock Text="Memuat data..."
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#475569"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>


                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>

                        <TextBlock Text="{Binding PaginationSummary}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   FontWeight="Medium" />


                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Tampilkan:" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                      SelectedItem="{Binding PageSize}"
                                      Height="32"
                                      FontSize="12"
                                      MinWidth="76"
                                      Padding="8,0"
                                      VerticalContentAlignment="Center"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="per halaman" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Margin="6,0,0,0" />
                        </StackPanel>


                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:Button Command="{Binding PrevPageCommand}" Style="{StaticResource PaginationNavButton}" ToolTip="Halaman Sebelumnya">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ChevronLeft20" FontSize="12" Margin="0,0,3,0" />
                                    <TextBlock Text="Prev" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <ItemsControl ItemsSource="{Binding PageNumbers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="{Binding PageNumber}"
                                                Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding PageNumber}"
                                                Style="{StaticResource PaginationNumberButton}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ui:Button Command="{Binding NextPageCommand}" Style="{StaticResource PaginationNavButton}" ToolTip="Halaman Berikutnya">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Next" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                    <ui:SymbolIcon Symbol="ChevronRight20" FontSize="12" Margin="3,0,0,0" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
