<Window x:Class="Entry_Data_Processing.Features.RequestKodeBarang.Views.Dialogs.ApprovalWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Entry_Data_Processing.Features.RequestKodeBarang.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ApprovalWizardViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Approval Wizard Kode Barang"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="680"
        SizeToContent="Height"
        MaxHeight="820"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <!-- Outer Shadow Layer -->
    <Grid Margin="18">
        <Border Background="#FFFFFF" 
                BorderBrush="#CBD5E1" 
                BorderThickness="1" 
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="8" Opacity="0.22" Color="#0F172A" />
            </Border.Effect>

            <Grid Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header & Stepper -->
                    <RowDefinition Height="*"/>    <!-- Content Body -->
                    <RowDefinition Height="Auto"/> <!-- Footer Controls -->
                </Grid.RowDefinitions>

                <!-- 1. Header Bar with Stepper Indicator -->
                <Border Grid.Row="0" 
                        Background="#FFFFFF" 
                        BorderBrush="#F1F5F9" 
                        BorderThickness="0,0,0,1" 
                        Padding="24,18,24,14" 
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="OnHeaderMouseDown">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkStarburst24" FontSize="20" Foreground="#0284C7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Approval Wizard Kode Barang" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Lengkapi master data produk, harga jual, dan item barang sebelum menyetujui request" FontSize="11.5" Foreground="#64748B" Margin="28,2,0,0"/>

                        <!-- Stepper Indicator Pills -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Step 1 Tab -->
                            <Border Grid.Column="0" Margin="0,0,4,0" Padding="10,8" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                                <Setter Property="Background" Value="#0284C7"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="1" BlurRadius="6" Opacity="0.3"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="1. Master Produk" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Step 2 Tab -->
                            <Border Grid.Column="1" Margin="4,0,4,0" Padding="10,8" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                                <Setter Property="Background" Value="#0284C7"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="1" BlurRadius="6" Opacity="0.3"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="2. Harga Jual" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Step 3 Tab -->
                            <Border Grid.Column="2" Margin="4,0,0,0" Padding="10,8" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                                <Setter Property="Background" Value="#0284C7"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="1" BlurRadius="6" Opacity="0.3"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="3. Item Barang" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Scrollable Body Content -->
                <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16" Background="#FFFFFF">
                    <Grid>
                        <!-- STEP 1: Data Produk -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Mode Selector Segmented Tab (Mutually Exclusive) -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="4" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Segment 1: Cari Produk Terdaftar -->
                                    <Border Grid.Column="0" 
                                            CornerRadius="9" 
                                            Padding="14,10" 
                                            Cursor="Hand"
                                            Margin="0,0,3,0"
                                            MouseLeftButtonDown="OnSelectExistingMode">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E2E8F0"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsNewProductMode}" Value="False">
                                                        <Setter Property="Background" Value="#0284C7"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.35"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Search24" FontSize="16" Margin="0,0,8,0">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNewProductMode}" Value="False">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Text="Pilih Produk Terdaftar" FontSize="12.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNewProductMode}" Value="False">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Segment 2: Buat Master Produk Baru -->
                                    <Border Grid.Column="1" 
                                            CornerRadius="9" 
                                            Padding="14,10" 
                                            Cursor="Hand"
                                            Margin="3,0,0,0"
                                            MouseLeftButtonDown="OnSelectNewMode">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E2E8F0"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsNewProductMode}" Value="True">
                                                        <Setter Property="Background" Value="#0284C7"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.35"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="AddCircle24" FontSize="16" Margin="0,0,8,0">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNewProductMode}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Text="Buat Master Produk Baru" FontSize="12.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNewProductMode}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- MODE A: SEARCH EXISTING PRODUCT -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewProductMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Selected Product Card (When chosen) -->
                                <Border Background="#F0FDF4" 
                                        BorderBrush="#86EFAC" 
                                        BorderThickness="1.5" 
                                        CornerRadius="10" 
                                        Padding="14,12" 
                                        Margin="0,0,0,12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedProduct}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="#16A34A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="PRODUK TERPILIH" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Border>
                                                <TextBlock Text="{Binding ProductData.BrPrdKd}" FontSize="14" FontWeight="Bold" Foreground="#15803D"/>
                                                <TextBlock Text=" - " FontSize="14" FontWeight="Bold" Foreground="#15803D"/>
                                                <TextBlock Text="{Binding ProductData.BrPrdNm}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ProductData.BrPrdAcm, StringFormat='Akronim: {0}'}" FontSize="11.5" Foreground="#64748B" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding ProductData.BrPrdFacNm, StringFormat='Pabrik: {0}'}" FontSize="11.5" Foreground="#64748B" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding ProductData.BrJnsNm, StringFormat='Jenis: {0}'}" FontSize="11.5" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="Ganti Produk" Command="{Binding ClearSelectedProductCommand}" Appearance="Secondary" VerticalAlignment="Center" Padding="12,5"/>
                                    </Grid>
                                </Border>

                                <!-- Search Box -->
                                <TextBlock Text="Ketik Kode atau Nama Produk" Style="{StaticResource FormLabelStyle}"/>
                                <ui:TextBox Text="{Binding ProductSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                            PlaceholderText="Cari kode (cth: 3RHTM) atau nama produk..." 
                                            Icon="{ui:SymbolIcon Search24}"
                                            Margin="0,0,0,10"/>

                                <!-- Search Results List -->
                                <TextBlock Text="Hasil Pencarian Produk:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" MaxHeight="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ProductSearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,8" Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Kode Badge -->
                                                            <Border Grid.Column="0" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding BrPrdKd}" FontSize="11.5" FontWeight="Bold" Foreground="#0369A1"/>
                                                            </Border>

                                                            <!-- Nama & Detail -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding BrPrdNm}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding BrPrdAcm, StringFormat='Acm: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="{Binding BrPrdFacNm, StringFormat='Pabrik: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="{Binding BrJnsNm, StringFormat='Jenis: {0}'}" FontSize="11" Foreground="#64748B"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Select Button -->
                                                            <ui:Button Grid.Column="2" 
                                                                       Content="Pilih" 
                                                                       Appearance="Primary" 
                                                                       Padding="14,4" 
                                                                       VerticalAlignment="Center"
                                                                       Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <!-- MODE B: CREATE NEW PRODUCT FORM -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewProductMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                
                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                                    <TextBlock Text="Isi data master produk baru:" FontSize="11.5" FontWeight="SemiBold" Foreground="#B45309"/>
                                </Border>

                                <TextBlock Text="Nama Produk" Style="{StaticResource FormLabelStyle}"/>
                                <ui:TextBox Text="{Binding ProductData.BrPrdNm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Kode Produk" Style="{StaticResource FormLabelStyle}"/>
                                        <ui:TextBox Text="{Binding ProductData.BrPrdKd, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" PlaceholderText="Maks. 5 karakter"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Akronim" Style="{StaticResource FormLabelStyle}"/>
                                        <ui:TextBox Text="{Binding ProductData.BrPrdAcm, UpdateSourceTrigger=PropertyChanged}" MaxLength="18"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Pabrik" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding FactorySearchResults}" 
                                                  SelectedItem="{Binding SelectedFactory}" 
                                                  DisplayMemberPath="DisplayText"
                                                  IsEditable="True" 
                                                  IsTextSearchEnabled="True" 
                                                  TextSearch.TextPath="DisplayText"
                                                  Loaded="SearchableComboBox_Loaded"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Jenis" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding ProductTypeSearchResults}" 
                                                  SelectedItem="{Binding SelectedProductType}" 
                                                  DisplayMemberPath="DisplayText"
                                                  IsEditable="True" 
                                                  IsTextSearchEnabled="True" 
                                                  TextSearch.TextPath="DisplayText"
                                                  Loaded="SearchableComboBox_Loaded"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Pencari" Style="{StaticResource FormLabelStyle}"/>
                                <ui:TextBox Text="{Binding ProductData.Pencari, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" Margin="0,0,0,12"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- STEP 2: Data Harga Jual -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Kode Produk Terpilih" Style="{StaticResource FormLabelStyle}"/>
                            <ui:TextBox Text="{Binding ProductData.BrPrdKd}" IsReadOnly="True" Margin="0,0,0,14" Background="#F8FAFC" FontWeight="Bold" Foreground="#0284C7"/>

                            <!-- Golongan Harga Searchable ComboBox -->
                            <TextBlock Text="Golongan Harga" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding PriceGroupSearchResults}" 
                                      SelectedItem="{Binding SelectedPriceGroup}" 
                                      IsEditable="True" 
                                      IsTextSearchEnabled="True"
                                      Loaded="SearchableComboBox_Loaded"
                                      Margin="0,0,0,14"/>

                            <!-- Satuan Searchable ComboBox -->
                            <TextBlock Text="Satuan" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding UnitSearchResults}" 
                                      SelectedItem="{Binding SelectedUnit}" 
                                      DisplayMemberPath="DisplayText"
                                      IsEditable="True" 
                                      IsTextSearchEnabled="True" 
                                      TextSearch.TextPath="DisplayText"
                                      Loaded="SearchableComboBox_Loaded"
                                      Margin="0,0,0,14"/>
                        </StackPanel>

                        <!-- STEP 3: Data Item Barang -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <TextBlock Text="No. Kode Barang" Style="{StaticResource FormLabelStyle}"/>
                            <ui:TextBox Text="{Binding ItemData.BrKdNo, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="0,0,0,14" PlaceholderText="Cth: 01"/>

                            <TextBlock Text="Nama Item Barang" Style="{StaticResource FormLabelStyle}"/>
                            <ui:TextBox Text="{Binding ItemData.BrNm, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" Margin="0,0,0,14"/>
                            
                            <!-- Live Preview Card -->
                            <Border Background="#F0FDF4" 
                                    BorderBrush="#BBF7D0" 
                                    BorderThickness="1" 
                                    CornerRadius="10" 
                                    Padding="14,10" 
                                    Margin="0,4,0,8">
                                <StackPanel>
                                    <TextBlock Text="Preview Kode Barang:" FontWeight="Bold" FontSize="11" Foreground="#15803D" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="#166534">
                                        <Run Text="{Binding ProductData.BrPrdKd}" />
                                        <Run Text="." />
                                        <Run Text="{Binding PriceData.SatKd}" />
                                        <Run Text="." />
                                        <Run Text="{Binding ItemData.BrKdNo}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 3. Rounded Footer Bar -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,14" CornerRadius="0,0,16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Cancel Button -->
                        <ui:Button Grid.Column="0" Content="Batal" Click="Cancel_Click" HorizontalAlignment="Left" Appearance="Secondary" Padding="16,6" />

                        <!-- Right: Stepper Navigation Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="Kembali" 
                                       Command="{Binding PreviousStepCommand}" 
                                       IsEnabled="{Binding CanGoPrevious}" 
                                       Margin="0,0,8,0" 
                                       Padding="16,6" />
                            
                            <!-- Lanjut Button -->
                            <ui:Button Content="Lanjut" 
                                       Command="{Binding NextStepCommand}" 
                                       IsEnabled="{Binding CanGoNext}" 
                                       Appearance="Primary" 
                                       Padding="18,6">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <!-- Selesai & Setujui Button -->
                            <ui:Button Content="Selesai &amp; Setujui" 
                                       Click="Submit_Click" 
                                       Appearance="Primary" 
                                       Padding="18,6">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Background" Value="#16A34A"/>
                                        <Setter Property="BorderBrush" Value="#15803D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
