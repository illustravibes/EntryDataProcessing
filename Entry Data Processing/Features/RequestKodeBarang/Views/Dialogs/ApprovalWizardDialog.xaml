<Window x:Class="Entry_Data_Processing.Features.RequestKodeBarang.Views.Dialogs.ApprovalWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Entry_Data_Processing.Features.RequestKodeBarang.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ApprovalWizardViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Approval Wizard Kode Barang"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="720"
        SizeToContent="Height"
        MaxHeight="820"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="FormLabelStyle" TargetType="ui:TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <!-- Outer Shadow Layer -->
    <Grid Margin="18">
        <Border Background="#FFFFFF" 
                BorderBrush="#CBD5E1" 
                BorderThickness="1" 
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="8" Opacity="0.22" Color="#0F172A" />
            </Border.Effect>

            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header & Stepper -->
                    <RowDefinition Height="*"/>    <!-- Content Body -->
                    <RowDefinition Height="Auto"/> <!-- Footer Controls -->
                </Grid.RowDefinitions>

                <!-- 1. Header Bar with Stepper Indicator -->
                <Border Grid.Row="0" 
                        Background="#FFFFFF" 
                        BorderBrush="#F1F5F9" 
                        BorderThickness="0,0,0,1" 
                        Padding="24,18,24,14" 
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="OnHeaderMouseDown">
                    <StackPanel>
                        <ui:TextBlock Text="Persetujuan &amp; Penerbitan Kode Barang" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        <ui:TextBlock Text="Verifikasi master produk, penetapan kelompok harga, dan registrasi kode barang baru." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>

                        <!-- Stepper Indicator Pills -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Step 1 Tab -->
                            <Border Grid.Column="0" Margin="0,0,4,0" Padding="10,8" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep1Done}" Value="True">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                                <Setter Property="Background" Value="#0284C7"/>
                                                <Setter Property="BorderBrush" Value="#0284C7"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="1" BlurRadius="6" Opacity="0.3"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon FontSize="14" Margin="0,0,6,0">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="Box24"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep1Done}" Value="True">
                                                        <Setter Property="Symbol" Value="Checkmark24"/>
                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                                        <Setter Property="Symbol" Value="Box24"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <ui:TextBlock Text="1. Master Produk" FontWeight="Bold" FontSize="11.5">
                                        <ui:TextBlock.Style>
                                            <Style TargetType="ui:TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep1Done}" Value="True">
                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Step 2 Tab -->
                            <Border Grid.Column="1" Margin="4,0,4,0" Padding="10,8" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep2Done}" Value="True">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                                <Setter Property="Background" Value="#0284C7"/>
                                                <Setter Property="BorderBrush" Value="#0284C7"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="1" BlurRadius="6" Opacity="0.3"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon FontSize="14" Margin="0,0,6,0">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="Tag24"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep2Done}" Value="True">
                                                        <Setter Property="Symbol" Value="Checkmark24"/>
                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                                        <Setter Property="Symbol" Value="Tag24"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <ui:TextBlock Text="2. Harga Jual" FontWeight="Bold" FontSize="11.5">
                                        <ui:TextBlock.Style>
                                            <Style TargetType="ui:TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep2Done}" Value="True">
                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Step 3 Tab -->
                            <Border Grid.Column="2" Margin="4,0,0,0" Padding="10,8" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                                <Setter Property="Background" Value="#0284C7"/>
                                                <Setter Property="BorderBrush" Value="#0284C7"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="1" BlurRadius="6" Opacity="0.3"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon FontSize="14" Margin="0,0,6,0">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="BarcodeScanner24"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <ui:TextBlock Text="3. Item Barang" FontWeight="Bold" FontSize="11.5">
                                        <ui:TextBlock.Style>
                                            <Style TargetType="ui:TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Scrollable Body Content -->
                <ui:DynamicScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16" Background="#FFFFFF">
                    <Grid>
                        <!-- STEP 1: Data Produk -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Mode Selector Segmented Tab (Mutually Exclusive) -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="4" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Segment 1: Cari Produk Terdaftar -->
                                    <Border Grid.Column="0" 
                                            CornerRadius="9" 
                                            Padding="14,10" 
                                            Cursor="Hand"
                                            Margin="0,0,3,0"
                                            MouseLeftButtonDown="OnSelectExistingMode">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E2E8F0"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsNewProductMode}" Value="False">
                                                        <Setter Property="Background" Value="#0284C7"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.35"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Search24" FontSize="16" Margin="0,0,8,0">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNewProductMode}" Value="False">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <ui:TextBlock Text="Pilih Produk Terdaftar" FontSize="12.5">
                                                <ui:TextBlock.Style>
                                                    <Style TargetType="ui:TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNewProductMode}" Value="False">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:TextBlock.Style>
                                            </ui:TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Segment 2: Buat Master Produk Baru -->
                                    <Border Grid.Column="1" 
                                            CornerRadius="9" 
                                            Padding="14,10" 
                                            Cursor="Hand"
                                            Margin="3,0,0,0"
                                            MouseLeftButtonDown="OnSelectNewMode">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E2E8F0"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsNewProductMode}" Value="True">
                                                        <Setter Property="Background" Value="#0284C7"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.35"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="AddCircle24" FontSize="16" Margin="0,0,8,0">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNewProductMode}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <ui:TextBlock Text="Buat Master Produk Baru" FontSize="12.5">
                                                <ui:TextBlock.Style>
                                                    <Style TargetType="ui:TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNewProductMode}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:TextBlock.Style>
                                            </ui:TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- MODE A: SEARCH EXISTING PRODUCT -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewProductMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Selected Product Card (When chosen) -->
                                <ui:Card Background="#F0FDF4" 
                                         BorderBrush="#86EFAC" 
                                         BorderThickness="1.5" 
                                         Padding="14,12" 
                                         Margin="0,0,0,12">
                                    <ui:Card.Style>
                                        <Style TargetType="ui:Card">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedProduct}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Card.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="#16A34A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <ui:TextBlock Text="PRODUK TERPILIH" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Border>
                                                <ui:TextBlock Text="{Binding ProductData.BrPrdKd}" FontSize="14" FontWeight="Bold" Foreground="#15803D"/>
                                                <ui:TextBlock Text=" - " FontSize="14" FontWeight="Bold" Foreground="#15803D"/>
                                                <ui:TextBlock Text="{Binding ProductData.BrPrdNm}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock Text="{Binding ProductData.BrPrdAcm, StringFormat='Akronim: {0}'}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                                                <ui:TextBlock Text="{Binding ProductData.BrPrdFacNm, StringFormat='Pabrik: {0}'}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                                                <ui:TextBlock Text="{Binding ProductData.BrJnsNm, StringFormat='Jenis: {0}'}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="Ganti Produk" Command="{Binding ClearSelectedProductCommand}" Appearance="Secondary" VerticalAlignment="Center" Padding="12,5"/>
                                    </Grid>
                                </ui:Card>

                                <!-- Search Box and Results (Collapsed once product is selected) -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedProduct}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Search Box -->
                                    <ui:TextBlock Text="Cari Produk" Style="{StaticResource FormLabelStyle}"/>
                                    <ui:TextBox Text="{Binding ProductSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                                PlaceholderText="cari produk ..." 
                                                Icon="{ui:SymbolIcon Search24}"
                                                Margin="0,0,0,10"/>

                                    <!-- Search Results List -->
                                    <ui:TextBlock Text="Hasil Pencarian Produk:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" MaxHeight="220">
                                        <ui:DynamicScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ProductSearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,8" Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Kode Badge -->
                                                                <Border Grid.Column="0" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <ui:TextBlock Text="{Binding BrPrdKd}" FontSize="11.5" FontWeight="Bold" Foreground="#0369A1"/>
                                                                </Border>

                                                                <!-- Nama & Detail -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <ui:TextBlock Text="{Binding BrPrdNm}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <ui:TextBlock Text="{Binding BrPrdAcm, StringFormat='Acm: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                                                        <ui:TextBlock Text="{Binding BrPrdFacNm, StringFormat='Pabrik: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                                                        <ui:TextBlock Text="{Binding BrJnsNm, StringFormat='Jenis: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Select Button -->
                                                                <ui:Button Grid.Column="2" 
                                                                           Content="Pilih" 
                                                                           Appearance="Primary" 
                                                                           Padding="14,4" 
                                                                           VerticalAlignment="Center"
                                                                           Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ui:DynamicScrollViewer>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- MODE B: CREATE NEW PRODUCT FORM -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewProductMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- 1. Kode Produk Field & Live Validation -->
                                <ui:TextBlock Text="Kode Produk" Style="{StaticResource FormLabelStyle}"/>
                                <ui:TextBox Text="{Binding NewProductCode, UpdateSourceTrigger=PropertyChanged}" 
                                            MaxLength="5" 
                                            PlaceholderText="kode produk ..." 
                                            CharacterCasing="Upper"
                                            FontSize="13" 
                                            FontWeight="SemiBold"
                                            Margin="0,0,0,4"/>

                                <!-- Live Validation Indicator -->
                                <Border Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Spinner when checking -->
                                        <ui:ProgressRing Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <ui:ProgressRing.Style>
                                                <Style TargetType="ui:ProgressRing">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCheckingProductCode}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:ProgressRing.Style>
                                        </ui:ProgressRing>

                                        <!-- Success Icon -->
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15" Foreground="#16A34A" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsProductCodeValid}" Value="True"/>
                                                                <Condition Binding="{Binding IsCheckingProductCode}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>

                                        <!-- Error Icon -->
                                        <ui:SymbolIcon Symbol="DismissCircle24" FontSize="15" Foreground="#DC2626" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsProductCodeValid}" Value="False"/>
                                                                <Condition Binding="{Binding IsCheckingProductCode}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>

                                        <!-- Message -->
                                        <ui:TextBlock Text="{Binding ProductCodeValidationMessage}" FontSize="11" VerticalAlignment="Center">
                                            <ui:TextBlock.Style>
                                                <Style TargetType="ui:TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProductCodeValid}" Value="True">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsProductCodeValid}" Value="False">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:TextBlock.Style>
                                        </ui:TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Detail Data Produk (Enabled once code is checked / available) -->
                                <StackPanel IsEnabled="{Binding IsProductCodeValid}">
                                    <!-- Row 1: Nama Produk & Akronim -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <ui:TextBlock Text="Nama Produk" Style="{StaticResource FormLabelStyle}"/>
                                            <ui:TextBox Text="{Binding ProductData.BrPrdNm, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="nama produk ..."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <ui:TextBlock Text="Akronim" Style="{StaticResource FormLabelStyle}"/>
                                            <ui:TextBox Text="{Binding ProductData.BrPrdAcm, UpdateSourceTrigger=PropertyChanged}" MaxLength="18" PlaceholderText="akronim ..."/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Pabrik & Jenis Barang -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <ui:TextBlock Text="Pabrik" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding FactorySearchResults}" 
                                                      SelectedItem="{Binding SelectedFactory}" 
                                                      DisplayMemberPath="DisplayText" 
                                                      Tag="Pilih Pabrik"
                                                      IsEditable="True" 
                                                      IsTextSearchEnabled="True" 
                                                      TextSearch.TextPath="DisplayText"
                                                      Loaded="SearchableComboBox_Loaded"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <ui:TextBlock Text="Jenis" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding ProductTypeSearchResults}" 
                                                      SelectedItem="{Binding SelectedProductType}" 
                                                      DisplayMemberPath="DisplayText" 
                                                      Tag="Pilih Jenis"
                                                      IsEditable="True" 
                                                      IsTextSearchEnabled="True" 
                                                      TextSearch.TextPath="DisplayText"
                                                      Loaded="SearchableComboBox_Loaded"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 3: Pencari -->
                                    <ui:TextBlock Text="Pencari" Style="{StaticResource FormLabelStyle}"/>
                                    <ui:TextBox Text="{Binding ProductData.Pencari, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" PlaceholderText="pencari ..." Margin="0,0,0,12"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- STEP 2: Data Harga Jual -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Header Produk Terpilih -->
                            <ui:Card Background="#F0F9FF" BorderBrush="#BAE6FD" Padding="14,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0284C7" CornerRadius="6" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <ui:TextBlock Text="{Binding ProductData.BrPrdKd}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBlock Text="{Binding ProductData.BrPrdNm}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                                        <ui:TextBlock Text="Master produk yang akan ditentukan konfigurasi harga jualnya" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <!-- Golongan Harga Searchable ComboBox -->
                            <ui:TextBlock Text="Golongan Harga" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding PriceGroupSearchResults}" 
                                      SelectedItem="{Binding SelectedPriceGroup}" 
                                      Text="{Binding SelectedPriceGroup, UpdateSourceTrigger=PropertyChanged}"
                                      Tag="Pilih Golongan Harga"
                                      IsEditable="True" 
                                      IsTextSearchEnabled="True"
                                      Loaded="SearchableComboBox_Loaded"
                                      Margin="0,0,0,14"/>

                            <!-- Satuan Searchable ComboBox -->
                            <ui:TextBlock Text="Satuan" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding UnitSearchResults}" 
                                      SelectedItem="{Binding SelectedUnit}" 
                                      DisplayMemberPath="DisplayText" 
                                      Tag="Pilih Satuan"
                                      IsEditable="True" 
                                      IsTextSearchEnabled="True" 
                                      TextSearch.TextPath="DisplayText"
                                      Loaded="SearchableComboBox_Loaded"
                                      Margin="0,0,0,14"/>

                            <!-- Status Kombinasi Master Harga Jual (tmabrhrgjl & thrgjual) -->
                            <ui:Card Padding="14,10" Margin="0,2,0,8">
                                <ui:Card.Style>
                                    <Style TargetType="ui:Card">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPriceCombinationExisting}" Value="True">
                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPriceCombinationExisting}" Value="False">
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Card.Style>
                                <Grid>
                                    <!-- Case 1: Sudah Ada -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPriceCombinationExisting}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" Foreground="#16A34A" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <ui:TextBlock Text="Kombinasi Master Harga Sudah Terdaftar (tmabrhrgjl)" FontWeight="Bold" FontSize="11.5" Foreground="#15803D"/>
                                            <ui:TextBlock Text="Kombinasi produk, golongan, dan satuan ini sudah ada. Sistem akan langsung menggunakannya." FontSize="10.5" Foreground="#166534"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Case 2: Belum Ada (Auto-Create) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPriceCombinationExisting}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ui:SymbolIcon Symbol="Info24" FontSize="20" Foreground="#0284C7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <ui:TextBlock Text="Kombinasi Harga Baru (Belum Terdaftar di tmabrhrgjl)" FontWeight="Bold" FontSize="11.5" Foreground="#0369A1"/>
                                            <ui:TextBlock Text="Kombinasi ini belum terdaftar. Masukkan ID Harga baru di bawah ini untuk pendaftaran." FontSize="10.5" Foreground="#0284C7"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Case 3: Belum Dipilih Lengkap -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPriceCombinationExisting}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ui:SymbolIcon Symbol="Lightbulb24" FontSize="18" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Pilih Golongan Harga dan Satuan di atas untuk mengecek status kombinasi harga jual." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <!-- Field Manual Input ID Harga (Hanya Muncul Jika Belum Ada di Master tmabrhrgjl) -->
                            <StackPanel Margin="0,4,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPriceCombinationExisting}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:TextBlock Text="ID Harga" Style="{StaticResource FormLabelStyle}"/>
                                <ui:TextBox Text="{Binding NewIdHrgText, UpdateSourceTrigger=PropertyChanged}" 
                                            PlaceholderText="id harga ..." 
                                            MaxLength="5" 
                                            FontSize="13" 
                                            FontWeight="SemiBold" 
                                            Margin="0,0,0,4"/>
                                <ui:TextBlock Text="* Masukkan ID Harga (id_hrg) baru untuk pendaftaran ke tabel tmabrhrgjl." 
                                              FontSize="10.5" 
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                              Margin="0,0,0,8"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- STEP 3: Data Item Barang -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <!-- Prominent Live Preview Card on Top -->
                            <ui:Card Background="#F0FDF4" 
                                     BorderBrush="#86EFAC" 
                                     BorderThickness="1.5" 
                                     Padding="16,14" 
                                     Margin="0,0,0,16">
                                <StackPanel HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="16" Foreground="#15803D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="PREVIEW KODE BARANG AKHIR YANG AKAN DI-GENERATE:" FontWeight="Bold" FontSize="11" Foreground="#15803D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ui:TextBlock FontSize="22" FontWeight="ExtraBold" Foreground="#166534" HorizontalAlignment="Center">
                                        <Run Text="{Binding ProductData.BrPrdKd}" />
                                        <Run Text="." />
                                        <Run Text="{Binding PriceData.SatKd}" />
                                        <Run Text="." />
                                        <Run Text="{Binding ItemData.BrKdNo}" />
                                    </ui:TextBlock>
                                    <ui:TextBlock Text="Format: {Kode Produk}.{Satuan}.{No. Kode Barang}" FontSize="10.5" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.85"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- Input No Kode Barang -->
                            <ui:TextBlock Text="No. Kode Barang" Style="{StaticResource FormLabelStyle}"/>
                            <ui:TextBox Text="{Binding ItemData.BrKdNo, UpdateSourceTrigger=PropertyChanged}" MaxLength="25" Margin="0,0,0,4" PlaceholderText="no. kode barang ..." FontSize="13" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="* Tentukan kode penomoran barang manual sesuai formula/aturan internal EDP." FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"/>

                            <!-- Read-only Summary Fields -->
                            <ui:TextBlock Text="Nama Barang" Style="{StaticResource FormLabelStyle}"/>
                            <ui:TextBox Text="{Binding ItemData.BrNm}" IsReadOnly="True" Background="#F8FAFC" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <ui:TextBlock Text="Golongan Harga" Style="{StaticResource FormLabelStyle}"/>
                                    <ui:TextBox Text="{Binding PriceData.BrHrgGol}" IsReadOnly="True" Background="#F8FAFC"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <ui:TextBlock Text="Satuan" Style="{StaticResource FormLabelStyle}"/>
                                    <ui:TextBox Text="{Binding PriceData.SatKd}" IsReadOnly="True" Background="#F8FAFC"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <ui:TextBlock Text="Status" Style="{StaticResource FormLabelStyle}"/>
                                    <ui:TextBox Text="Aktif" IsReadOnly="True" Background="#F0FDF4" Foreground="#15803D" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Summary ID Harga Baru jika baru didaftarkan -->
                            <StackPanel Margin="0,0,0,12">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPriceCombinationExisting}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:TextBlock Text="ID Harga (Baru)" Style="{StaticResource FormLabelStyle}"/>
                                <ui:TextBox Text="{Binding PriceData.IdHrg}" IsReadOnly="True" Background="#F8FAFC" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ui:DynamicScrollViewer>

                <!-- 3. Rounded Footer Bar -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,14" CornerRadius="0,0,16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Cancel Button -->
                        <ui:Button Grid.Column="0" Content="Batal" Click="Cancel_Click" HorizontalAlignment="Left" Appearance="Secondary" Padding="16,6" />

                        <!-- Right: Stepper Navigation Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="Kembali" 
                                       Icon="{ui:SymbolIcon ArrowLeft20}"
                                       Command="{Binding PreviousStepCommand}" 
                                       IsEnabled="{Binding CanGoPrevious}" 
                                       Appearance="Secondary"
                                       Margin="0,0,8,0" 
                                       Padding="16,6" />
                            
                            <!-- Lanjut Button (WPF UI Primary Button) -->
                            <ui:Button Content="Lanjut" 
                                       Icon="{ui:SymbolIcon ArrowRight20}"
                                       Command="{Binding NextStepCommand}" 
                                       IsEnabled="{Binding CanGoNext}" 
                                       Appearance="Primary" 
                                       Padding="18,6"
                                       Visibility="{Binding IsNotLastStep, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!-- Selesai & Setujui Button (WPF UI Primary/Success Button) -->
                            <ui:Button Content="Selesai &amp; Setujui" 
                                       Icon="{ui:SymbolIcon Checkmark20}"
                                       Click="Submit_Click" 
                                       Appearance="Primary" 
                                       Padding="18,6"
                                       Visibility="{Binding IsLastStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. Loading Overlay (WPF UI ProgressRing) -->
                <Border Grid.Row="0" 
                        Grid.RowSpan="3" 
                        Background="#66000000" 
                        CornerRadius="16"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        <ui:TextBlock Text="Memproses data, harap tunggu..." FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Modal Toast Alert: Absolute top layer of wizard modal, bottom-right, compact -->
        <ui:SnackbarPresenter x:Name="DialogSnackbar"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="0,0,16,16"
                              MaxWidth="360"
                              Panel.ZIndex="99999" />
    </Grid>
</Window>
