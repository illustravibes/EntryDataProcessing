<Window x:Class="Entry_Data_Processing.Features.RequestKodeBarang.Views.Dialogs.ReqKodeDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Entry_Data_Processing.Features.RequestKodeBarang.Models"
        mc:Ignorable="d"
        Title="Detail Permohonan Kode Barang"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="740"
        SizeToContent="Height"
        MaxHeight="880"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="8" Opacity="0.22" Color="#0F172A" />
            </Border.Effect>

            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#FFFFFF"
                        BorderBrush="#F1F5F9"
                        BorderThickness="0,0,0,1"
                        Padding="22,14"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="OnHeaderMouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="19" Foreground="#0284C7" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Detail Permohonan Kode Barang" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />

                                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasKdBrg, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="13" Foreground="#16A34A" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding KdBrg}" FontSize="12" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Informasi lengkap pengajuan kode barang dari toko" FontSize="11.5" Foreground="#64748B" Margin="27,2,0,0" />
                        </StackPanel>


                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" MaxHeight="720" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,14,22,10" Background="#FFFFFF">
                    <StackPanel Background="#FFFFFF">

                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="Building24" FontSize="16" Foreground="#0284C7" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TokoKodeAndName}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                        <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AreaBadge}" FontSize="9.5" FontWeight="Bold" Foreground="#0369A1" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tanggal Request: " FontSize="11.5" Foreground="#64748B" />
                                        <TextBlock Text="{Binding FormattedTglRequest}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,12,0" />
                                        <TextBlock Text="Diajukan Oleh: " FontSize="11.5" Foreground="#64748B" />
                                        <TextBlock Text="{Binding PengajuDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FEF3C7" />
                                            <Setter Property="BorderBrush" Value="#FDE68A" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NormalizedStatus}" Value="Disetujui">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                    <Setter Property="BorderBrush" Value="#BBF7D0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NormalizedStatus}" Value="Ditolak">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                    <Setter Property="BorderBrush" Value="#FECACA" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NormalizedStatus}" Value="Draft">
                                                    <Setter Property="Background" Value="#EEF2FF" />
                                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ui:TextBlock Text="{Binding StatusBadgeText}" FontSize="11.5" FontWeight="Bold">
                                        <ui:TextBlock.Style>
                                            <Style TargetType="ui:TextBlock">
                                                <Setter Property="Foreground" Value="#B45309" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NormalizedStatus}" Value="Disetujui">
                                                        <Setter Property="Foreground" Value="#15803D" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NormalizedStatus}" Value="Ditolak">
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NormalizedStatus}" Value="Draft">
                                                        <Setter Property="Foreground" Value="#4338CA" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="Box20" FontSize="14" Foreground="#475569" Margin="0,0,6,0" />
                                    <TextBlock Text="Informasi Barang" FontSize="12.5" FontWeight="Bold" Foreground="#334155" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Nama Barang:" Style="{StaticResource DetailLabelStyle}" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NmBrg}" Style="{StaticResource DetailValueStyle}" Margin="0,3,8,3" />
                                    <Border CornerRadius="5" Padding="5,1.5" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E0F2FE" />
                                                <Setter Property="BorderBrush" Value="#BAE6FD" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMix}" Value="True">
                                                        <Setter Property="Background" Value="#FCE7F3" />
                                                        <Setter Property="BorderBrush" Value="#FBCFE8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RmBadgeText}" FontSize="9" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#0284C7" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMix}" Value="True">
                                                            <Setter Property="Foreground" Value="#DB2777" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>


                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Jenis Barang:" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding JenisDisplay}" Style="{StaticResource DetailValueStyle}" />


                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Golongan / Satuan:" Style="{StaticResource DetailLabelStyle}" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Gol, TargetNullValue='-'}" Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Text=" / " Style="{StaticResource DetailLabelStyle}" Margin="2,0" />
                                    <TextBlock Text="{Binding Sat, TargetNullValue='-'}" Style="{StaticResource DetailValueStyle}" />
                                </StackPanel>


                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Kode Barang:" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding KdBrg, TargetNullValue='Belum disetujui'}" Style="{StaticResource DetailValueStyle}" Foreground="#0284C7" FontWeight="Bold" />
                            </Grid>
                        </Border>


                        <Border Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="VehicleTruckProfile20" FontSize="14" Foreground="#475569" Margin="0,0,6,0" />
                                    <TextBlock Text="Informasi Supplier" FontSize="12.5" FontWeight="Bold" Foreground="#334155" />
                                </StackPanel>


                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Nama Supplier:" Style="{StaticResource DetailLabelStyle}" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SupplierNamaDisplay}" Style="{StaticResource DetailValueStyle}" Margin="0,3,6,3" />
                                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="4,1" VerticalAlignment="Center" Visibility="{Binding IsNewSupplier, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="BARU" FontSize="8.5" FontWeight="Bold" Foreground="#B45309" />
                                    </Border>
                                </StackPanel>


                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Kode Supplier:" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SupplierKodeDisplay}" Style="{StaticResource DetailValueStyle}" Foreground="#334155" />
                            </Grid>
                        </Border>


                        <Border Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="Money20" FontSize="14" Foreground="#475569" Margin="0,0,6,0" />
                                    <TextBlock Text="Informasi Harga &amp; Pembelian" FontSize="12.5" FontWeight="Bold" Foreground="#334155" />
                                </StackPanel>


                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Pricelist:" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormattedPricelist, StringFormat='{}Rp {0}'}" Style="{StaticResource DetailValueStyle}" />


                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Diskon:" Style="{StaticResource DetailLabelStyle}" />
                                <Border Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" CornerRadius="5" Padding="6,1.5" Margin="0,3" Background="{Binding DiscBadgeBackground}" BorderBrush="{Binding DiscBadgeBorder}" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DiscBadgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding DiscBadgeForeground}" />
                                </Border>


                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Harga Beli (Nett):" Style="{StaticResource DetailLabelStyle}" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FormattedHrgBeli, StringFormat='{}Rp {0}'}" FontSize="14" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" />


                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Faktur Pajak:" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DetailValueStyle}">
                                            <Setter Property="Text" Value="Tidak" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FakturPajak}" Value="True">
                                                    <Setter Property="Text" Value="Ya (Ada Faktur Pajak)" />
                                                    <Setter Property="Foreground" Value="#15803D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>


                        <Border Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="Note20" FontSize="14" Foreground="#475569" Margin="0,0,6,0" />
                                    <TextBlock Text="Keterangan &amp; Catatan" FontSize="12.5" FontWeight="Bold" Foreground="#334155" />
                                </StackPanel>


                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Keterangan Toko:" Style="{StaticResource DetailLabelStyle}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding KetBeli, TargetNullValue='Tidak ada keterangan tambahan.'}" Style="{StaticResource DetailValueStyle}" TextWrapping="Wrap" />


                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Petugas ACC:" Style="{StaticResource DetailLabelStyle}" Margin="0,4,0,3" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccByDisplay}" Style="{StaticResource DetailValueStyle}" FontWeight="SemiBold" Margin="0,4,0,3" />


                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Tanggal Disetujui:" Style="{StaticResource DetailLabelStyle}" Margin="0,4,0,3" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,3">
                                    <ui:SymbolIcon Symbol="CalendarClock24" FontSize="14" Foreground="#0284C7" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding HasAccAt, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding FormattedTglAcc}" Style="{StaticResource DetailValueStyle}" FontWeight="SemiBold" Foreground="#0F172A" />
                                </StackPanel>


                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Alasan Penolakan:" Style="{StaticResource DetailLabelStyle}" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Top" Margin="0,4,0,0" Visibility="{Binding IsRejected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Border Grid.Row="4" Grid.Column="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,3,0,0" Visibility="{Binding IsRejected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding KeteranganTolak, TargetNullValue='-'}" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" FontWeight="Medium" />
                                </Border>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="22,14" CornerRadius="0,0,16,16">
                    <Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ui:Button Content="Tutup"
                               Appearance="Secondary"
                               Padding="18,6"
                               HorizontalAlignment="Right"
                               Click="OnCloseClicked" />
                            <ui:Button Content="Tolak Permohonan"
                                Appearance="Secondary"
                                Icon="{ui:SymbolIcon Dismiss20}"
                                Visibility="{Binding CanApproveOrReject, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="OnRejectClicked" />
                            <ui:Button Content="Setujui Permohonan"
                                Appearance="Primary"
                                Icon="{ui:SymbolIcon Checkmark20}"
                                Visibility="{Binding CanApproveOrReject, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="OnApproveClicked" />
                        </StackPanel>

                    </Grid>
                </Border>
            </Grid>
        </Border>


        <ui:SnackbarPresenter x:Name="DialogSnackbar"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="0,0,16,16"
                              MaxWidth="360"
                              Panel.ZIndex="99999" />
    </Grid>
</Window>
