<Page x:Class="Entry_Data_Processing.Features.RequestKodeBarang.Views.ReqKodeDetailPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         Title="Detail Request Kode Barang">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding GoBackCommand}" Appearance="Transparent" Margin="0,0,10,0" />
            <TextBlock Text="Detail Request Kode Barang" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="0,0,20,0">
                <ui:CardControl Header="Informasi Barang" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nomor Request" FontWeight="SemiBold" Margin="0,5" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RequestDetail.NoRequest}" Margin="0,5" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nama Barang" FontWeight="SemiBold" Margin="0,5" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RequestDetail.NmBrg}" Margin="0,5" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Jenis Barang" FontWeight="SemiBold" Margin="0,5" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RequestDetail.JnsBrg}" Margin="0,5" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Supplier" FontWeight="SemiBold" Margin="0,5" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RequestDetail.Supplier}" Margin="0,5" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Satuan" FontWeight="SemiBold" Margin="0,5" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RequestDetail.Satuan}" Margin="0,5" />
                    </Grid>
                </ui:CardControl>

                <ui:CardControl Header="Informasi Harga" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Harga Beli" FontWeight="SemiBold" Margin="0,5" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RequestDetail.HrgBeli, StringFormat=\{0:N0\}}" Margin="0,5" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Pricelist" FontWeight="SemiBold" Margin="0,5" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RequestDetail.Pricelist, StringFormat=\{0:N0\}}" Margin="0,5" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Diskon (%)" FontWeight="SemiBold" Margin="0,5" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RequestDetail.Disc}" Margin="0,5" />
                    </Grid>
                </ui:CardControl>
                
                <ui:CardControl Header="Status &amp; Keterangan">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" FontWeight="SemiBold" Margin="0,5" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RequestDetail.StatusLabel}" Margin="0,5" FontWeight="Bold" Foreground="{Binding RequestDetail.AccTidak, Converter={StaticResource StatusToColorConverter}}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Keterangan Request" FontWeight="SemiBold" Margin="0,5" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RequestDetail.Keterangan}" Margin="0,5" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Keterangan Ditolak" FontWeight="SemiBold" Margin="0,5" Visibility="{Binding RequestDetail.KeteranganTolak, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RequestDetail.KeteranganTolak}" Margin="0,5" TextWrapping="Wrap" Foreground="Red" Visibility="{Binding RequestDetail.KeteranganTolak, Converter={StaticResource NullToVisibilityConverter}}" />
                    </Grid>
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,15,0,0" Padding="0,15,0,0"
                Visibility="{Binding CanApproveOrReject, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Tolak Permohonan" Appearance="Danger" Command="{Binding RejectCommand}" Margin="0,0,10,0" Icon="{ui:SymbolIcon Dismiss24}" />
                <ui:Button Content="Setujui Permohonan" Appearance="Primary" Command="{Binding ApproveCommand}" Icon="{ui:SymbolIcon Checkmark24}" />
            </StackPanel>
        </Border>

        <ui:ProgressRing Grid.Row="1" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Page>
