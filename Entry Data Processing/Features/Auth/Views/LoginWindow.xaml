<ui:FluentWindow x:Class="Entry_Data_Processing.Features.Auth.Views.LoginWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="EDP Portal" Height="520" Width="400"
                  WindowStartupLocation="CenterScreen"
                  ResizeMode="NoResize">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" 
                     Title="EDP Portal" 
                     Icon="{ui:ImageIcon 'pack://application:,,,/Assets/logo.png'}" 
                     CloseWindowByDoubleClickOnIcon="False" />

        <Grid Grid.Row="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" Margin="0,-20,0,0">
                <Image Source="/Assets/logo.png" Height="84" HorizontalAlignment="Center" Margin="0,0,0,18" />
                <ui:TextBlock Text="EDP Portal" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" />
                <ui:TextBlock Text="Silakan login untuk melanjutkan" FontSize="13.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,26" />
                
                <ui:TextBlock Text="NIP" Margin="0,0,0,5" FontWeight="Medium" />
                <ui:TextBox Text="{Binding Nip, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Masukkan NIP..." Margin="0,0,0,15" />
                
                <ui:TextBlock Text="Password" Margin="0,0,0,5" FontWeight="Medium" />
                <ui:PasswordBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Masukkan password..." Margin="0,0,0,12" />

                <Border Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,9"
                        Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ErrorCircle20"
                                       Foreground="#DC2626"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#B91C1C"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ui:Button Appearance="Primary" Command="{Binding LoginCommand}" HorizontalAlignment="Stretch" IsDefault="True" Padding="0,8">
                    <Grid>
                        <ui:TextBlock Text="Login"
                                      HorizontalAlignment="Center"
                                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="20"
                                         Height="20"
                                         HorizontalAlignment="Center"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
