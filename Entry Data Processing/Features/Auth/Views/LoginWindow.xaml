<ui:FluentWindow x:Class="Entry_Data_Processing.Features.Auth.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="EDP Portal - Login" Height="500" Width="400"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize">
    <Grid>
        <ui:SnackbarPresenter x:Name="RootSnackbar" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" Margin="0,-40,0,0">
            <ui:SymbolIcon Symbol="Person24" FontSize="64" Foreground="{DynamicResource BrandYellow}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="EDP Portal" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" />
            <TextBlock Text="Silakan login untuk melanjutkan" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,30" />
            
            <TextBlock Text="NIP" Margin="0,0,0,5" />
            <ui:TextBox Text="{Binding Nip, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Masukkan NIP..." Margin="0,0,0,15" />
            
            <TextBlock Text="Password" Margin="0,0,0,5" />
            <ui:PasswordBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Masukkan password..." Margin="0,0,0,25" />
            
            <ui:Button Content="Login" Appearance="Primary" Command="{Binding LoginCommand}" HorizontalAlignment="Stretch" />
            
            <ui:ProgressRing IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
